# LLM is optional. Decisions are always deterministic; the LLM only polishes email wording,
# writes short document notes and extracts fields from uploaded files.
LLM_PROVIDER=none            # anthropic | gemini | none  (auto-detected from keys if unset)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

STAGE_DELAY_MS=600           # pause between stages so the live view is watchable (0 in tests)
DB_PATH=./data/vendorguard.db
SEED_HISTORY=1               # seed ~15 historical runs when the DB is empty
PORT=8000
